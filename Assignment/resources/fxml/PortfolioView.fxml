<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="24.0"
      stylesheets="@../css/StyleSheet.css,@../css/style.css"
      styleClass="center-content"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="presentation.controllers.PortfolioController">

    <Label text="Portfolio" styleClass="welcome-title"/>

    <Label text="Track your holdings, cash balance, and portfolio performance."
           wrapText="true"
           styleClass="welcome-subtitle"/>

    <HBox spacing="20.0">
        <VBox prefWidth="220.0" styleClass="glass-card">
            <Label text="Total Value" styleClass="card-label"/>
            <Label fx:id="totalValueLabel" text="-" styleClass="card-value"/>
            <Label fx:id="todayChangeLabel" text="Live market value" styleClass="card-positive"/>
        </VBox>

        <VBox prefWidth="220.0" styleClass="glass-card">
            <Label text="Cash Balance" styleClass="card-label"/>
            <Label fx:id="cashBalanceLabel" text="-" styleClass="card-value"/>
            <Label text="Available to trade" styleClass="card-muted"/>
        </VBox>

        <VBox prefWidth="220.0" styleClass="glass-card">
            <Label text="Open Positions" styleClass="card-label"/>
            <Label fx:id="openPositionLabel" text="-" styleClass="card-value"/>
            <Label fx:id="holdingCountLabel" text="-" styleClass="card-muted"/>
        </VBox>
    </HBox>

    <ScrollPane fitToWidth="true"
                prefHeight="320.0"
                maxHeight="320.0"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                styleClass="transparent-scroll">

        <VBox fx:id="holdingsBox" spacing="10.0" styleClass="glass-card-large">
            <GridPane hgap="25.0">
                <columnConstraints>
                    <ColumnConstraints prefWidth="140.0"/>
                    <ColumnConstraints prefWidth="90.0"/>
                    <ColumnConstraints prefWidth="130.0"/>
                    <ColumnConstraints prefWidth="130.0"/>
                    <ColumnConstraints prefWidth="130.0"/>
                </columnConstraints>

                <Label text="Symbol" styleClass="table-header" GridPane.columnIndex="0"/>
                <Label text="Shares" styleClass="table-header" GridPane.columnIndex="1"/>
                <Label text="Avg Price" styleClass="table-header" GridPane.columnIndex="2"/>
                <Label text="Current" styleClass="table-header" GridPane.columnIndex="3"/>
                <Label text="P/L" styleClass="table-header" GridPane.columnIndex="4"/>
            </GridPane>
        </VBox>
    </ScrollPane>

    <HBox spacing="14.0">
        <Button text="Buy Stocks"
                onAction="#openBuyStocksFromPortfolio"
                styleClass="action-button-primary"/>

        <Button text="Sell Stocks"
                onAction="#openSellStocksFromPortfolio"
                styleClass="action-button-secondary"/>
    </HBox>

    <Region VBox.vgrow="ALWAYS"/>

</VBox>